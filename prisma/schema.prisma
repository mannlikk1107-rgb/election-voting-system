generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  VOTER
  CANDIDATE
  ADMINISTRATOR
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum ElectionStatus {
  DRAFT
  NOMINATION
  VOTING
  CLOSED
  PUBLISHED
  ARCHIVED
}

enum EligibilityStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NominationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                    String             @id @default(cuid())
  fullName              String
  email                 String             @unique
  username              String             @unique
  passwordHash          String
  role                  UserRole           @default(VOTER)
  accountStatus         AccountStatus      @default(ACTIVE)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  electionsCreated      Election[]         @relation("ElectionCreator")
  voterEligibilities    VoterEligibility[] @relation("EligibleVoter")
  reviewedEligibilities VoterEligibility[] @relation("EligibilityReviewer")
  nominations           Nomination[]       @relation("Nominee")
  reviewedNominations   Nomination[]       @relation("NominationReviewer")
  votes                 Vote[]
  reviewedAuditLogs     AuditLog[]         @relation("AuditActor")
}

model Election {
  id                 String             @id @default(cuid())
  title              String
  description        String             @db.Text
  rules              String             @default("") @db.Text
  nominationStart    DateTime
  nominationEnd      DateTime
  votingStart        DateTime
  votingEnd          DateTime
  status             ElectionStatus     @default(DRAFT)
  resultsPublishedAt DateTime?
  createdById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  createdBy          User               @relation("ElectionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  eligibilities      VoterEligibility[]
  votes              Vote[]
  nominations        Nomination[]

  @@index([status, votingStart, votingEnd])
  @@index([createdById])
}

model VoterEligibility {
  id              String            @id @default(cuid())
  userId          String
  electionId      String
  status          EligibilityStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation("EligibleVoter", fields: [userId], references: [id], onDelete: Cascade)
  election        Election          @relation(fields: [electionId], references: [id], onDelete: Cascade)
  reviewedBy      User?             @relation("EligibilityReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([electionId, userId])
  @@index([electionId, status])
  @@index([userId])
}

model Nomination {
  id                   String           @id @default(cuid())
  electionId           String
  userId               String
  candidateDisplayName String
  biography            String           @db.Text
  manifesto            String           @db.Text
  status               NominationStatus @default(PENDING)
  reviewedById         String?
  reviewedAt           DateTime?
  rejectionReason      String?          @db.Text
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  election             Election         @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user                 User             @relation("Nominee", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy           User?            @relation("NominationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  votes                Vote[]

  @@unique([electionId, userId])
  @@unique([electionId, id])
  @@index([electionId, status])
}

model Vote {
  id           String     @id @default(cuid())
  electionId   String
  voterId      String
  nominationId String
  submittedAt  DateTime   @default(now())
  election     Election   @relation(fields: [electionId], references: [id], onDelete: Restrict)
  voter        User       @relation(fields: [voterId], references: [id], onDelete: Restrict)
  nomination   Nomination @relation(fields: [electionId, nominationId], references: [electionId, id], onDelete: Restrict)

  @@unique([electionId, voterId])
  @@index([electionId, nominationId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  details     Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
}
