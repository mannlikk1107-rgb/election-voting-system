<%- include('../partials/header', { title }) %>
<div class="section-heading"><div><p class="eyebrow">CANDIDATE REVIEW · 候選人審核</p><h1>Nomination approval</h1></div><span class="status-label"><%= records.length %> pending</span></div>
<div class="vstack gap-3"><% records.forEach((record) => { %><article class="review-card"><div class="d-flex flex-wrap justify-content-between gap-2"><div><p class="eyebrow"><%= record.election.title %></p><h2><%= record.candidateDisplayName %></h2><p class="text-secondary">Submitted by <%= record.user.fullName %> (@<%= record.user.username %>)</p></div><small><%= record.createdAt.toLocaleDateString() %></small></div><h3>Biography</h3><p class="preserve-lines"><%= record.biography %></p><h3>Manifesto</h3><p class="preserve-lines"><%= record.manifesto %></p><form action="/admin/nominations/<%= record.id %>/review" method="post" class="review-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary" name="status" value="APPROVED" type="submit">Approve candidate</button><input class="form-control" name="rejectionReason" placeholder="Reason, if rejecting"><button class="btn btn-outline-danger" name="status" value="REJECTED" type="submit">Reject nomination</button></form></article><% }) %><% if (!records.length) { %><div class="empty-state"><h2>All caught up</h2><p>There are no nominations awaiting review.</p></div><% } %></div>
<%- include('../partials/footer') %>