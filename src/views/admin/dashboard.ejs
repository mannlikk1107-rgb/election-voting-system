<%- include('../partials/header', { title }) %>
<div class="section-heading"><div><p class="eyebrow">CONTROL ROOM</p><h1>Administrator dashboard</h1></div><a class="btn btn-primary" href="/admin/elections/new">Create election</a></div>
<div class="stats-grid"><% Object.entries({ 'Total users': stats.totalUsers, 'Pending voter requests': stats.pendingEligibility, 'Active elections': stats.activeElections, 'Pending nominations': stats.pendingNominations, 'Recorded votes': stats.totalVotes, 'Awaiting publication': stats.awaitingPublication }).forEach(([label, count]) => { %><div class="stat-tile"><span><%= label %></span><strong><%= count %></strong></div><% }) %></div>
<section class="admin-links"><h2>Manage the election</h2><div class="row g-2"><div class="col-md-4"><a href="/elections" class="admin-link">Election management <span>→</span></a></div><div class="col-md-4"><a href="/admin/eligibilities" class="admin-link">Voter approval <span>→</span></a></div><div class="col-md-4"><a href="/admin/nominations" class="admin-link">Nomination review <span>→</span></a></div><div class="col-md-4"><a href="/elections" class="admin-link">Result preview / publication <span>→</span></a></div><div class="col-md-4"><a href="/admin/audit-logs" class="admin-link">Audit log <span>→</span></a></div></div></section>
