<%- include('../partials/header', { title }) %>
<div class="narrow-page"><p class="eyebrow">ELECTION SETUP · 選舉設定</p><h1><%= election.id ? 'Edit election' : 'Create election' %></h1><form action="<%= election.id ? `/admin/elections/${election.id}?_method=PUT` : '/admin/elections' %>" method="post" class="vstack gap-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div><label class="form-label" for="title">Election title</label><input class="form-control" id="title" name="title" maxlength="160" value="<%= election.title || '' %>" required></div>
  <div><label class="form-label" for="description">Description</label><textarea class="form-control" id="description" name="description" rows="3" required><%= election.description || '' %></textarea></div>
  <div><label class="form-label" for="rules">Rules (optional)</label><textarea class="form-control" id="rules" name="rules" rows="3"><%= election.rules || '' %></textarea></div>
  <% const dateInput = (date) => date ? new Date(date).toISOString().slice(0, 16) : ''; %>
  <div class="row g-3"><div class="col-sm-6"><label class="form-label" for="nominationStart">Nominations open</label><input class="form-control" id="nominationStart" name="nominationStart" type="datetime-local" value="<%= dateInput(election.nominationStart) %>" required></div><div class="col-sm-6"><label class="form-label" for="nominationEnd">Nominations close</label><input class="form-control" id="nominationEnd" name="nominationEnd" type="datetime-local" value="<%= dateInput(election.nominationEnd) %>" required></div><div class="col-sm-6"><label class="form-label" for="votingStart">Voting opens</label><input class="form-control" id="votingStart" name="votingStart" type="datetime-local" value="<%= dateInput(election.votingStart) %>" required></div><div class="col-sm-6"><label class="form-label" for="votingEnd">Voting closes</label><input class="form-control" id="votingEnd" name="votingEnd" type="datetime-local" value="<%= dateInput(election.votingEnd) %>" required></div></div>
  <button class="btn btn-primary" type="submit"><%= election.id ? 'Save changes' : 'Create draft' %></button>
</form></div>
<%- include('../partials/footer') %>