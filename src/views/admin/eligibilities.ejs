<%- include('../partials/header', { title }) %>
<div class="section-heading"><div><p class="eyebrow">VOTER ROLL</p><h1>Voter approval</h1></div><span class="status-label"><%= records.length %> records</span></div>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Voter</th><th>Election</th><th>Status</th><th>Vote recorded</th><th>Review</th></tr></thead><tbody><% records.forEach((record) => { %><tr><td><strong><%= record.user.fullName %></strong><br><small><%= record.user.email %></small></td><td><a href="/elections/<%= record.election.id %>"><%= record.election.title %></a></td><td><%= record.status %></td><td><%= record.hasVoted ? 'Yes' : 'No' %></td><td><% if (record.status === 'PENDING') { %><form action="/admin/eligibilities/<%= record.id %>/review" method="post" class="review-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-primary" name="status" value="APPROVED" type="submit">Approve</button><input class="form-control form-control-sm" name="rejectionReason" placeholder="Reason, if rejecting"><button class="btn btn-sm btn-outline-danger" name="status" value="REJECTED" type="submit">Reject</button></form><% } else { %><span class="text-secondary">Reviewed</span><% } %></td></tr><% }) %><% if (!records.length) { %><tr><td colspan="5" class="text-secondary">No voter requests to review.</td></tr><% } %></tbody></table></div>
<%- include('../partials/footer') %>