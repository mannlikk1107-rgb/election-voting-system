<%- include('../partials/header', { title }) %>
<div class="section-heading"><div><p class="eyebrow"><%= preview ? 'ADMINISTRATOR PREVIEW' : 'OFFICIAL RESULTS' %></p><h1><%= results.election.title %></h1></div><span class="status-label"><%= results.election.status %></span></div>
<% if (preview) { %><div class="alert alert-warning">These results are a private administrator preview and have not been published.</div><% } %>
<div class="result-summary"><div><span>Total votes cast</span><strong><%= results.totalVotes %></strong></div><div><span>Approved voters</span><strong><%= results.eligibleVoterCount %></strong></div><div><span>Turnout</span><strong><%= results.turnoutPercentage.toFixed(1) %>%</strong></div></div>
<section class="content-section"><h2>Candidate totals</h2><% results.candidates.forEach((candidate) => { %><div class="result-row"><div class="d-flex justify-content-between gap-3"><strong><%= candidate.candidateDisplayName %></strong><span><%= candidate.votes %> votes · <%= candidate.percentage.toFixed(1) %>%</span></div><div class="progress" role="progressbar" aria-label="<%= candidate.candidateDisplayName %> vote share" aria-valuenow="<%= candidate.percentage.toFixed(1) %>" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width: <%= candidate.percentage %>%"></div></div></div><% }) %><% if (!results.candidates.length) { %><p>No approved candidates were recorded.</p><% } %></section>
<section class="winner-panel"><p class="eyebrow">RESULT</p><% if (!results.winners.length) { %><h2>No votes were recorded</h2><% } else if (results.isTie) { %><h2>Tied winners</h2><p><%= results.winners.map((candidate) => candidate.candidateDisplayName).join(', ') %></p><% } else { %><h2>Winner: <%= results.winners[0].candidateDisplayName %></h2><p><%= results.winners[0].votes %> votes</p><% } %></section>
<%- include('../partials/footer') %>