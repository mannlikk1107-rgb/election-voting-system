<%- include('../partials/header', { title }) %>
<% const statusTransitions = { DRAFT: ['NOMINATION'], NOMINATION: ['VOTING'], VOTING: ['CLOSED'], CLOSED: ['PUBLISHED'], PUBLISHED: ['ARCHIVED'], ARCHIVED: [] }; const nextStatuses = statusTransitions[election.status] || []; %>
<div class="section-heading"><div><p class="eyebrow">ELECTION DETAILS</p><h1><%= election.title %></h1></div><span class="status-label"><%= election.status %></span></div>
<p class="lead-copy"><%= election.description %></p>
<div class="row g-4 election-details"><div class="col-lg-7"><section class="content-section"><h2>Timeline</h2><dl class="timeline-list"><div><dt>Nominations open</dt><dd><%= election.nominationStart.toLocaleString() %></dd></div><div><dt>Nominations close</dt><dd><%= election.nominationEnd.toLocaleString() %></dd></div><div><dt>Voting opens</dt><dd><%= election.votingStart.toLocaleString() %></dd></div><div><dt>Voting closes</dt><dd><%= election.votingEnd.toLocaleString() %></dd></div></dl></section>
  <% if (election.rules) { %><section class="content-section"><h2>Election rules</h2><p class="preserve-lines"><%= election.rules %></p></section><% } %>
  <section class="content-section"><h2>Approved candidates</h2><% if (!election.nominations.length) { %><p class="text-secondary">Candidates will appear here after nominations are approved.</p><% } %><% election.nominations.forEach((candidate) => { %><article class="candidate-row"><h3><%= candidate.candidateDisplayName %></h3><p><%= candidate.biography %></p><p class="preserve-lines"><%= candidate.manifesto %></p></article><% }) %></section>
</div><aside class="col-lg-5"><div class="action-panel"><h2>Take part</h2>
  <% if (!currentUser) { %><p>Sign in to request voter approval or submit a nomination.</p><a class="btn btn-primary w-100" href="/login">Sign in</a>
  <% } else { %>
    <% if (currentUser.role === 'VOTER' && election.status !== 'PUBLISHED' && election.status !== 'ARCHIVED') { %><p>Voter approval: <strong><%= eligibility ? eligibility.status : 'Not requested' %></strong></p><% if (!eligibility || eligibility.status === 'REJECTED') { %><form action="/elections/<%= election.id %>/eligibility" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-primary w-100" type="submit">Request voter approval</button></form><% } %><% } %>
    <% if (election.status === 'NOMINATION') { %><hr><h3>Stand as a candidate</h3><% if (nomination && nomination.status === 'APPROVED') { %><p class="mb-1"><strong class="text-success">Approved</strong></p><p class="text-secondary small mb-0">Your nomination is approved and appears on the ballot.</p><% } else { %><form action="/elections/<%= election.id %>/nominations" method="post" class="vstack gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label" for="candidateDisplayName">Candidate display name</label><input class="form-control" id="candidateDisplayName" name="candidateDisplayName" maxlength="100" value="<%= nomination ? nomination.candidateDisplayName : '' %>" required><label class="form-label" for="biography">Biography</label><textarea class="form-control" id="biography" name="biography" rows="3" minlength="20" required><%= nomination ? nomination.biography : '' %></textarea><label class="form-label" for="manifesto">Manifesto</label><textarea class="form-control" id="manifesto" name="manifesto" rows="4" minlength="20" required><%= nomination ? nomination.manifesto : '' %></textarea><button class="btn btn-outline-primary" type="submit">Submit nomination</button></form><% } %><% } %>
    <% if (currentUser.role === 'VOTER' && election.status === 'VOTING' && eligibility?.status === 'APPROVED') { %><hr><a class="btn btn-primary w-100" href="/elections/<%= election.id %>/vote">Go to ballot</a><% } %>
  <% } %>
  <% if (election.status === 'PUBLISHED') { %><hr><a class="btn btn-primary w-100" href="/results/<%= election.id %>">View published results</a><% } %>
  <% if (currentUser && currentUser.role === 'ADMINISTRATOR') { %>
    <hr>
    <% if (election.status === 'DRAFT') { %><a class="btn btn-outline-primary w-100 mb-2" href="/admin/elections/<%= election.id %>/edit">Edit draft</a><% } %>
    <% if (nextStatuses.length) { %>
      <form action="/admin/elections/<%= election.id %>/status" method="post" class="d-flex gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select class="form-select" name="status" aria-label="Next election status"><% nextStatuses.forEach((status) => { %><option value="<%= status %>"><%= status %></option><% }) %></select><button class="btn btn-warm" type="submit">Change status</button></form>
    <% } else { %><p class="text-secondary small mb-0">Final status reached.</p><% } %>
    <% if (['CLOSED', 'PUBLISHED'].includes(election.status)) { %><a class="btn btn-link mt-2" href="/results/<%= election.id %>">Preview results</a><% } %>
  <% } %>
</div></aside></div>
<%- include('../partials/footer') %>