<%- include('../partials/header', { title }) %>
<div class="section-heading"><div><p class="eyebrow">CAMPUS BALLOT</p><h1>Elections & Results</h1><p class="section-description">Browse current elections and open published results.</p></div><% if (currentUser && currentUser.role === 'ADMINISTRATOR') { %><a class="btn btn-primary" href="/admin/elections/new">Create election</a><% } %></div>
<% if (!elections.length) { %><div class="empty-state"><h2>No elections have been created</h2><p>Check back when your university publishes its next election.</p></div><% } %>
<div class="row g-3"><% elections.forEach((election) => { %><div class="col-lg-6"><article class="election-card"><div class="d-flex justify-content-between"><span class="status-label"><%= election.status %></span><small>Voting ends <%= election.votingEnd.toLocaleDateString() %></small></div><h2><a href="/elections/<%= election.id %>"><%= election.title %></a></h2><p><%= election.description %></p><% if (election.status === 'PUBLISHED' || (currentUser?.role === 'ADMINISTRATOR' && election.status === 'CLOSED')) { %><a class="text-link" href="/results/<%= election.id %>">View results →</a><% } else { %><a class="text-link" href="/elections/<%= election.id %>">Election details →</a><% } %></article></div><% }) %></div>
<%- include('../partials/footer') %>