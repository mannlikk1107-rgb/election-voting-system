<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#153c34">
  <title><%= title || 'University Elections' %> | Campus Ballot</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/styles.css" rel="stylesheet">
</head>
<body>
<% if (currentUser && currentPath !== '/') { %>
<div class="authenticated-shell">
  <%- include('authenticated-sidebar') %>
  <div class="authenticated-main">
    <%- include('authenticated-header') %>
    <main class="authenticated-content">
<% } else { %>
<%- include('navbar') %>
<main class="container page-shell">
<% } %>
  <% if (flash) { %>
    <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
      <%= flash.text %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>