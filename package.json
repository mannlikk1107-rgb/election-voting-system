{
  "name": "election-voting-system",
  "version": "1.0.0",
  "description": "University election and voting system prototype",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "migrate:dry-run": "prisma migrate diff --from-empty --to-schema-datamodel ./prisma/schema.prisma --script",
    "prisma:seed": "node prisma/seed.js",
    "db:session-store": "node scripts/create-session-table.js",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "election",
    "voting",
    "prisma",
    "express"
  ],
  "author": "University Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^9.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.2",
    "express-validator": "^7.0.0",
    "helmet": "^8.0.0",
    "method-override": "^3.0.0",
    "pg": "^8.12.0",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
